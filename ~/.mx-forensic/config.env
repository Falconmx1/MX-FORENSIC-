# MX-FORENSIC Master Configuration
# TheHive Configuration
export THEHIVE_URL="https://thehive.yourcompany.com"
export THEHIVE_API_KEY="your-api-key-here"
export THEHIVE_ORG="your-org"

# MISP Configuration
export MISP_URL="https://misp.yourcompany.com"
export MISP_API_KEY="your-api-key-here"
export MISP_VERIFY_SSL=false

# Defaults
export DEFAULT_SEVERITY=2  # medium
export DEFAULT_TLP=2       # amber
export AUTO_UPLOAD=false
export UPLOAD_METHOD="scp"

# Alerting
export WEBHOOK_URL="https://your-webhook.com"
export ALERT_EMAIL="security@yourcompany.com"

# Retention
export RETENTION_DAYS=30
export EVIDENCE_ENCRYPTION=true
